# このファイルをコピーして「.env」という名前で保存し、実際の値を入力してください。
# .env ファイルは絶対に他人と共有したり、GitHubにアップロードしないでください。
# (実際の本番実行はGitHub Actions上で、ここではなくGitHub Secretsの値を使って行われる。
#  このファイルはローカルで動作確認する場合の参考用)

# Instagramビジネスアカウント連携用(Meta開発者サイトで取得)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# キャプション自動生成用(Anthropicコンソールで取得)
ANTHROPIC_API_KEY=

# LINE通知用(LINE Developersコンソールで取得)。
# LINE_USER_IDは「たけしさん個人」のLINEユーザーID。
# 調べ方はworker/publish-worker.jsの冒頭コメント、またはREADME.mdを参照。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# 投稿確認リンクの署名・公開用Worker(Cloudflare Workers)関連。
# worker/フォルダをデプロイした後に発行されるURL等を設定する。
PUBLISH_SIGNING_SECRET=
PUBLISH_WORKER_URL=

# 以下はGitHub Actions実行時に自動で設定される値なので、ローカルでは通常不要
# GITHUB_REPOSITORY=
# GITHUB_REF_NAME=
